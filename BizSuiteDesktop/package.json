{
  "name": "bizsuite-desktop",
  "version": "1.3.0",
  "description": "BizSuite - Offline-First Business Management Software",
  "main": "main.js",
  "author": "BizSuite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ParamBuilds/bizzsuite.git"
  },
  "scripts": {
    "start": "electron .",
    "start:debug": "electron . --debug",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.bizsuite.desktop",
    "productName": "BizSuite",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "auto-updater.js",
      "dist/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "ParamBuilds",
      "repo": "bizzsuite",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "dist/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BizSuite"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
